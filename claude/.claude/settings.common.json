{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh pr create *)",
      "Bash(gh pr edit *)"
    ]
  },
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "env": { "SSL_CERT_FILE": "/etc/ssl/cert.pem", "NODE_USE_ENV_PROXY": "1" },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [
      "fork *",
      "docker *",
      "gh *",
      "pinact *",
      "mise ls-remote *",
      "mise outdated*",
      "mise install *",
      "mise upgrade *"
    ],
    "filesystem": {
      "allowWrite": [
        "/tmp",
        "/private/tmp",
        "~/work/gopath/pkg/mod",
        "~/work/gopath/pkg/sumdb",
        "~/Library/Caches/go-build",
        "~/Library/Caches/mise",
        "~/Library/Caches/golangci-lint",
        "~/Library/Caches/pnpm",
        "~/.npm/_logs",
        "~/.npm/_cacache",
        "~/.local/state/mise"
      ],
      "denyWrite": ["/etc", "/usr/local/bin", "~/Library/Caches/pnpm/dlx"],
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.netrc",
        "~/.gnupg/private-keys-v1.d",
        "~/.docker"
      ]
    },
    "credentials": {
      "files": [
        { "path": "~/.config/gcloud", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.npmrc", "mode": "deny" }
      ],
      "envVars": []
    },
    "network": {
      "allowAllUnixSockets": false,
      "allowUnixSockets": [
        "/var/run/docker.sock",
        "~/.orbstack/run/docker.sock",
        "~/.gnupg/S.gpg-agent",
        "~/.gnupg/S.keyboxd"
      ],
      "allowedDomains": [
        "code.claude.com",
        "api.github.com",
        "github.com",
        "proxy.golang.org",
        "sum.golang.org",
        "mise-versions.jdx.dev",
        "registry.npmjs.org",
        "nodejs.org"
      ],
      "deniedDomains": [],
      "allowLocalBinding": true
    }
  }
}
